# Profile for the IXACHI cluster, used by pipeline steps 16-26 (ANI, chimerism
# screening and the whole anvi'o pangenome branch). Steps 01-15 ran on a
# different machine; their profile is server.env.example.
#
#   cp configs/server_ixachi.env.example configs/server_ixachi.env
#
# The two profiles exist because anvi'o 9 would not build on the first cluster
# (the datrie dependency fails there), so the pangenome work moved hosts. Keep
# both files if you split the work the same way; otherwise one profile is enough.

# ---- cluster connection ----
SERVER_USER=your-username
SERVER_HOST=cluster.example.edu
SERVER_PORT=22
SERVER="${SERVER_USER}@${SERVER_HOST}"

# ---- project layout on the cluster ----
SERVER_PROJECT_ROOT="/path/to/your/scratch"
PROJECT_DIR="${SERVER_PROJECT_ROOT}/msc_archaea"

# ---- project layout on the local machine ----
LOCAL_PROJECT_ROOT="${HOME}/msc_archaea"
LOCAL_SCRIPTS_DIR="${LOCAL_PROJECT_ROOT}/scripts"
LOCAL_RESULTS_DIR="${LOCAL_PROJECT_ROOT}/results"
LOCAL_DATA_DIR="${LOCAL_PROJECT_ROOT}/data"

# ---- output subdirectories ----
RAWFILES_SUBDIR="01_raw_files"
FILTERED_SUBDIR="01_raw_files/filtered"
QUALITY_SUBDIR="02_mags_quality"
TAXONOMY_SUBDIR="03_taxonomy_assigned"
GENE_PREDICTION_SUBDIR="04_gene_prediction"
FUNCTIONAL_ANNOTATION_SUBDIR="05_functional_annotation"
KO_ASSIGNMENT_SUBDIR="06_KO_assignment"
METABOLIC_RECONSTRUCTION_SUBDIR="07_metabolic_reconstruction"
MAG_DISTILL_SUBDIR="08_MAG_distill"
GTDBTK_DENOVO_TREE_SUBDIR="09_de_novo_tree"
MARKER_ALIGNMENT_SUBDIR="10_marker_alignment"
TRIMAL_SUBDIR="11_remove_uninformative_seqs"
MARKER_CONCAT_SUBDIR="12_marker_concatenation"
PHYLOGENY_SUBDIR="13_phylogeny"
PANGENOME_SUBDIR="14_pangenome"
LOGS_SUBDIR="logs"
TEMP_SUBDIR="temp"

MAGS_METADATA="${PROJECT_DIR}/MAGs_metadata.tsv"

# ---- reference databases ----
GTDBTK_DB="/path/to/gtdbtk/release226"
GTDB_SKETCH_DIR="/path/to/skani_gtdb_r226-v0.3"
GUNC_DB="/path/to/gunc/GUNC_v1.1.0"

# ---- MIMAG quality thresholds ----
MIN_COMPLETENESS=50.0
MAX_CONTAMINATION=10.0
HIGH_QUALITY_COMPLETENESS=90.0
HIGH_QUALITY_CONTAMINATION=5.0
