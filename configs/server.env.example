# Every shell script in scripts/pipeline/ and scripts/utils/ sources this file
# through scripts/lib/common.sh, which exports everything it defines. Copy it to
# server.env and fill in the database paths; server.env itself is gitignored so
# your paths never end up in a commit.
#
#   cp configs/server.env.example configs/server.env
#
# common.sh sets REPO_ROOT, the root of this clone, before reading the file, so
# the project layout below works unchanged in a fresh clone. If the work is
# split across machines, keep one copy per machine and point CONFIG_FILE at the
# one each step should read.

# ---- project layout ----
# PROJECT_DIR is where the analysis lives, the clone itself by default. Point it
# at a scratch filesystem if the clone sits somewhere small.
PROJECT_DIR="${PROJECT_DIR:-${REPO_ROOT}}"

# Input MAGs, one .fa file per genome. The directory is not tracked by git.
MAGS_DIR="${PROJECT_DIR}/data/mags"

# Every step writes under RESULTS_DIR/<step>_<name>, and the R scripts read the
# same tree, so moving results/ from a cluster to a laptop is all it takes to
# go from the pipeline to the figures.
RESULTS_DIR="${PROJECT_DIR}/results"

MAGS_METADATA="${REPO_ROOT}/data/MAGs_metadata.tsv"

# ---- output subdirectories under RESULTS_DIR, one per pipeline step ----
QUALITY_SUBDIR="01_mag_quality"
# The MIMAG-filtered MAGs that utils/01_filter_mags.py writes after step 01.
# Every step from 02 onward reads them.
FILTERED_SUBDIR="01_mag_quality/filtered"
CHIMERISM_SUBDIR="02_chimerism"
TAXONOMY_SUBDIR="03_taxonomy_assigned"
ANI_SUBDIR="04_sketching_ani"
GENE_PREDICTION_SUBDIR="05_gene_prediction"
FUNCTIONAL_ANNOTATION_SUBDIR="06_functional_annotation"
DRAM_ANNOTATION_SUBDIR="07_functional_annotation_DRAM"
KO_ASSIGNMENT_SUBDIR="08_KO_assignment"
METABOLIC_RECONSTRUCTION_SUBDIR="09_metabolic_reconstruction"
MAG_DISTILL_SUBDIR="10_MAG_distill"
GTDBTK_DENOVO_TREE_SUBDIR="11_de_novo_tree"
MARKER_ALIGNMENT_SUBDIR="12_marker_alignment"
TRIMAL_SUBDIR="13_remove_uninformative_seqs"
MARKER_CONCAT_SUBDIR="14_marker_concatenation"
PHYLOGENY_SUBDIR="15_phylogeny"
# Steps 16 to 18 share one directory; step 19 has its own.
FOCUSED_PHYLOGENY_SUBDIR="16_10mag_phylogeny"
FOCUSED_DENOVO_TREE_SUBDIR="19_10mag_de_novo_tree"
PANGENOME_SUBDIR="20_pangenome"

# Logs and scratch sit next to results/, under PROJECT_DIR.
LOGS_SUBDIR="logs"
TEMP_SUBDIR="temp"

# ---- reference databases ----
# The release matters, and README.md lists the one each step ran against:
# GTDB R226 for GTDB-Tk and for the skani sketches alike.
GTDBTK_DB="/path/to/gtdbtk/release226"
GTDB_SKETCH_DIR="/path/to/skani_gtdb_r226-v0.3"
CHECKM2_DB="/path/to/checkm2/uniref100.KO.1.dmnd"
EGGNOG_DATA_DIR="/path/to/eggnog-mapper-data"
GUNC_DB="/path/to/gunc_db"
# DRAM v1 (step 07). Empty makes DRAM fall back to the location in its own CONFIG.
DRAM_DB_DIR=""
# DRAM2 (step 10). The Nextflow config reads this from the environment.
DRAM2_DB_DIR="/path/to/DRAM_v2_databases"
# anvi'o snapshots that step 21 downloads once and reuses: KEGG (about 30 GB)
# and Pfam (about 3 GB).
KEGG_DATA_DIR="/path/to/anvio_databases/kegg_data"
PFAM_DATA_DIR="/path/to/anvio_databases/pfam_data"

# ---- DRAM2 pipeline (step 10) ----
# The thesis ran a fork of DRAM2 that carries fixes to the KEGG database
# formatting, the archaea-calibrated trait rules and the configuration of
# step 10. This pins the exact commit; slurm/DRAM2_HPC_install.slurm clones it
# into DRAM2_REPO. The analyses ran aa5889d7; the pinned commit only adds the
# configuration files on top of it, so the pipeline code is the same.
DRAM2_PIPELINE="ruben1294/DRAM"
DRAM2_REVISION="68a2d53d8d6a6d9649f836b11b50e7967b2571cf"
DRAM2_REPO="${PROJECT_DIR}/tools/DRAM2"
# Nextflow profile that selects the container engine: docker, singularity,
# apptainer or podman, whichever the machine that runs DRAM2 offers.
DRAM2_PROFILE="docker"
# DRAM2 submits its own jobs to SLURM. Leave the partition and node list empty
# to use the cluster defaults, or set DRAM2_USE_SLURM=false to run on the
# current machine instead.
DRAM2_USE_SLURM="true"
DRAM2_PARTITION=""
DRAM2_NODELIST=""
# Nextflow's work directory, which keeps the intermediate files of every task
# for -resume and grows large. Empty means PROJECT_DIR/work/DRAM2.
DRAM2_WORK_DIR=""
# Globus collection that receives the DRAM2 databases, for
# scripts/utils/DRAM2_HPC_download_dbs.sh. Only that script reads it.
GLOBUS_DEST_UUID=""

# ---- optional tool overrides ----
# Leave empty to use whatever is on PATH in the active conda environment.
MAFFT_PATH=""
TRIMAL_PATH=""

# ---- MIMAG quality thresholds ----
# utils/01_filter_mags.py applies these after step 01. The values are the MIMAG
# bands (Bowers et al. 2017); medium quality takes strictly less than
# MAX_CONTAMINATION, high quality at most HIGH_QUALITY_CONTAMINATION.
MIN_COMPLETENESS=50.0
MAX_CONTAMINATION=10.0
HIGH_QUALITY_COMPLETENESS=90.0
HIGH_QUALITY_CONTAMINATION=5.0
