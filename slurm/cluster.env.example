# Cluster-specific setup for the SLURM wrappers. Copy to cluster.env and edit:
#
#   cp slurm/cluster.env.example slurm/cluster.env
#
# cluster.env is gitignored, so your cluster's module names stay out of commits.
#
# Only the body of each wrapper reads this. The #SBATCH lines at the top of each
# file are parsed by sbatch before any of it runs, so --account and --partition
# have to be edited in the wrappers themselves.

# Environment module providing conda. Leave empty if conda is already on PATH.
CLUSTER_MODULE="conda-2023_metagenomica"

# conda.sh, which defines the shell function `conda activate`. Without sourcing
# it, `conda activate` fails inside a non-interactive job even when the conda
# binary is on PATH. Leave empty if your module already does this.
CONDA_PROFILE="/path/to/miniconda3/etc/profile.d/conda.sh"
